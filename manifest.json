{
  "manifest_version": 3,
  "name": "Avala Work Alert Pro",
  "version": "1.0.5",
  "description": "Local, persistent new-work alerts for the Avala worker dashboard.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen",
    "tts"
  ],
  "host_permissions": [
    "https://avala.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://avala.ai/*"
      ],
      "js": [
        "detector.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Avala Work Alert Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
